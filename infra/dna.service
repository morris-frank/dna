# systemd unit for the dna stream server.
# Install:
#   sudo cp infra/dna.service /etc/systemd/system/
#   sudo cp infra/dna.env.example /opt/dna/dna.env   # then edit
#   sudo systemctl daemon-reload && sudo systemctl enable --now dna
#
# Stateless: on restart it resumes at the correct f(now) index automatically.
[Unit]
Description=dna genome stream server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/dna
EnvironmentFile=/opt/dna/dna.env
ExecStart=/usr/bin/node /opt/dna/server/server.js
Restart=always
RestartSec=2
# Light hardening (artifacts are read-only at runtime).
NoNewPrivileges=true
ProtectSystem=strict
ReadOnlyPaths=/opt/dna
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
