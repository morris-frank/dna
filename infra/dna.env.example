# Environment for the dna systemd service. Copy to /opt/dna/dna.env.
#
# Pacing: set START_EPOCH plus EXACTLY ONE of RATE or RUNTIME_SECONDS.
# For a 3.2 Gb genome:  ~101 b/s  -> ~1 year   |   ~1235 b/s -> ~30 days.

DNA_ARTIFACTS_DIR=/opt/dna/artifacts
DNA_WEB_DIR=/opt/dna/web
DNA_LISTEN=127.0.0.1:8080

DNA_START_EPOCH=2026-06-01T00:00:00Z
# DNA_RATE=101
DNA_RUNTIME_SECONDS=31536000

DNA_TAIL=4096
DNA_TICK_MS=250
# DNA_PILEUP=true   # auto-detected from artifacts if unset
