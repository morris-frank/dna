# Caddy front for dna: automatic HTTPS + reverse proxy to the Node server.
# Serves dna.maurice-frank.com; override with the DNA_DOMAIN environment variable.
#
#   DNA_DOMAIN=other.example.org caddy run --config infra/Caddyfile
#
{$DNA_DOMAIN:dna.maurice-frank.com} {
	encode zstd gzip

	# SSE must not be buffered: flush every write immediately.
	@stream path /stream
	reverse_proxy @stream 127.0.0.1:8080 {
		flush_interval -1
	}

	# Everything else (/, /pileup) proxied normally.
	reverse_proxy 127.0.0.1:8080
}
